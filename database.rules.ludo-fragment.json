{
  "rules": {
    "ludo": {
      "rooms": {
        "$roomId": {
          ".read": "auth != null && !root.child('ludo/bans').child(auth.uid).exists() && data.child('players').child(auth.uid).exists()",
          ".write": false
        }
      },
      "roomCodes": {
        ".read": false,
        ".write": false
      },
      "seasons": {
        "$seasonId": {
          "regions": {
            "$region": {
              "players": {
                ".read": "auth != null && !root.child('ludo/bans').child(auth.uid).exists()",
                ".write": false,
                ".indexOn": ["points"]
              }
            }
          }
        }
      },
      "bans": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": false
        }
      }
    }
  }
}
