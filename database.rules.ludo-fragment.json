{
  "rules": {
    "ludo": {
      "adminBootstrapClaimed": {
        ".read": false,
        ".write": false
      },
      "adminCodeAttempts": {
        "$uid": {
          ".read": false,
          ".write": false
        }
      },
      "rooms": {
        "$roomId": {
          ".read": "auth != null && !root.child('ludo/bans').child(auth.uid).exists() && data.child('players').child(auth.uid).exists()",
          ".write": false
        }
      },
      "roomCodes": {
        ".read": false,
        ".write": false
      },
      "seasons": {
        "$seasonId": {
          "regions": {
            "$region": {
              "modes": {
                "$mode": {
                  "players": {
                    ".read": "auth != null && !root.child('ludo/bans').child(auth.uid).exists()",
                    ".write": false,
                    ".indexOn": ["points"]
                  }
                }
              }
            }
          }
        }
      },
      "queues": {
        "$seasonId": {
          "$region": {
            "$mode": {
              "$uid": {
                ".read": "auth != null && auth.uid === $uid && !root.child('ludo/bans').child(auth.uid).exists()",
                ".write": false
              }
            }
          }
        }
      },
      "bans": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": false
        }
      }
    }
  }
}
